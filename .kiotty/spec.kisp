body	O	c2ac95b5	## 책임\n라이브러리 인스턴스 하나가 쓰는 store · usecase · 커서 · 버퍼를 모두 소유하고 사양 파일을 연다 (개발수칙 1.2).\n\n타입: Configuration, Context\n\n## 모듈 인터페이스\n```cpp\n// class Context\nexplicit Context(const Configuration& configuration);\nContext(const Context&) = delete;\nContext& operator=(const Context&) = delete;\nKiottySpecStatus open(Span<const char> database);\nKiottySpecStatus init(Span<const char> name);\nFailure& failure();\nWorkspace& workspace();\nconst ModelCatalog& catalog() const;\nEditor& editor();\nRelationEditor& relationEditor();\nLifecycle& lifecycle();\nFinder& finder();\nDiffer& differ();\nCursorPool& cursors();\nTextBuffer& work();\n// 함수\nconstexpr size_t VERSION_FACTOR = 4;\n```\n\n## 멤버 변수\n```cpp\n// Configuration\nsize_t maxItems {4096};\nsize_t maxRelations {16384};\nsize_t maxTags {8192};\nsize_t maxCheckpoints {4096};\nsize_t maxDecisionVersions {1024};\nsize_t maxBodyBytes {16 * 1024 * 1024};\nsize_t maxCursors {16};\nsize_t maxCursorRows {4096};\nsize_t workBufferBytes {256 * 1024};\n// Context\nbool _opened {false};\nSystemPath _root;\nFailure _failure;\nTextBuffer _work;\nModelCatalog _catalog;\nMetaStore _meta;\nCheckpointStore _checkpoints;\nItemStore _items;\nRelationStore _relations;\nDecisionStore _decisions;\nSpecFile _file;\nWorkspace _workspace;\nChecker _checker;\nLifecycle _lifecycle;\nEditor _editor;\nRelationEditor _relation_editor;\nCursorPool _cursors;\nFinder _finder;\nDiffer _differ;\n```\n\n## 의존 모듈\n- DSN-075 CursorPool\n- DSN-078 Differ\n- DSN-079 Finder\n- DSN-022 Failure\n- DSN-033 TextBuffer\n- DSN-041 file_system\n- DSN-046 CheckpointStore\n- DSN-048 DecisionStore\n- DSN-051 ItemStore\n- DSN-055 MetaStore\n- DSN-056 RelationStore\n- DSN-062 Checker\n- DSN-063 Editor\n- DSN-064 Lifecycle\n- DSN-065 ModelCatalog\n- DSN-067 RelationEditor\n- DSN-068 SpecFile\n- DSN-072 Workspace\n
