body	O	9606f537	## 책임\n.kisp 한 줄이 되는 버전 레코드: 항목 · 태그 · 관계 · 결정 기록 버전과 그 정체성.\n\n타입: ItemVersionLabel, ItemVersion, TagIdentity, TagVersion, RelationIdentity, RelationVersion, DecisionVersion\n\n## 모듈 인터페이스\n```cpp\n// struct ItemVersion\nIdentity identity() const;\n// struct TagIdentity\nbool operator<(TagIdentity other) const;\nbool operator==(TagIdentity other) const;\n// struct TagVersion\nIdentity identity() const;\n// struct RelationIdentity\nbool operator<(RelationIdentity other) const;\nbool operator==(RelationIdentity other) const;\n// struct RelationVersion\nIdentity identity() const;\n// struct DecisionVersion\nIdentity identity() const;\n// 함수\nconstexpr uint32_t NO_KEY = 0;\nconstexpr size_t MAX_DECISION_VERSION_LENGTH = 2048;\nconstexpr ItemKey makeItemKey(uint32_t key);\nconstexpr ItemKey makeItemKey(uint32_t key) { return ItemKey {key, 0}; }\nstatic_assert(sizeof(ItemVersionLabel) == 384, "unexpected padding");\nstatic_assert(sizeof(ItemVersion) == 40, "unexpected padding");\nstatic_assert(sizeof(TagIdentity) == 8, "unexpected padding");\nstatic_assert(sizeof(RelationIdentity) == 12, "unexpected padding");\nstatic_assert(sizeof(TagVersion) == 32, "unexpected padding");\nstatic_assert(sizeof(RelationVersion) == 32, "unexpected padding");\nstatic_assert(sizeof(DecisionVersion) == 20, "unexpected padding");\n```\n\n## 멤버 변수\n```cpp\n// ItemVersionLabel\nSummaryText summary {};\nTitleText title {};\n// ItemVersion\nuint64_t body_hash {};\nItemKey parent {};\nItemLabelHandle label {};\nuint32_t key {};\nuint32_t checkpoint {};\nuint32_t removed {};\nItemKind kind {};\n// TagIdentity\nuint32_t key {};\nuint32_t tag {};\n// TagVersion\nuint64_t value {};\nItemKey item {};\nuint32_t tag {};\nuint32_t checkpoint {};\nuint32_t removed {};\nuint32_t _padding {};\n// RelationIdentity\nuint32_t from {};\nuint32_t relation {};\nuint32_t to {};\n// RelationVersion\nItemKey from {};\nItemKey to {};\nuint32_t relation {};\nuint32_t checkpoint {};\nuint32_t removed {};