body	O	cd080d8c	## 시그니처\n```c\nKiottySpecStatus KiottySpec_open(const char *projectRoot, KiottySpec **out);  /* 프로젝트 루트의 .kiotty/spec.db 를 연다 (없으면 생성) */\n```\n\n## 사전조건\n- projectRoot 는 존재하는 디렉토리 (UTF-8 경로)\n\n## 사후조건\n- <projectRoot>/.kiotty/spec.db 를 열고 없으면 만든다. 구버전 스키마는 올린다\n- *out 에 핸들\n\n## 에러 코드\n- projectRoot 가 디렉토리가 아님, .kiotty 를 만들 수 없음: Io\n- SQLite 열기 실패: Db\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n\n## 소유권\n- *out 는 KiottySpec_close 로 닫는다\n- 입력 문자열은 호출 동안만 읽는다\n
body	O	cd79aff8	## 시그니처\n```c\nKiottySpecStatus KiottySpec_Result_last(KiottySpec *db, const char *targetId, KiottySpecResult **out);  /* 대상의 마지막 결과 */\n```\n\n## 사전조건\n- 없음\n\n## 사후조건\n- *out 에 대상의 가장 나중 결과\n\n## 에러 코드\n- 결과 없음: NotFound\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n\n## 소유권\n- *out 는 호출자가 KiottySpec_free\n- 입력 문자열은 호출 동안만 읽는다\n
body	O	cdb0ff14	## 개요\n함수 4 개를 묶은 개념 단위. 함수별 계약은 하위 항목에 있고, 여기에는 묶음 공통의 타입과 규약을 둔다.\n\n## 하위 함수\n- UI-100 KiottySpec_Decision_get\n- UI-101 KiottySpec_Decision_getAt\n- UI-102 KiottySpec_Decision_rewrite\n- UI-103 KiottySpec_Decision_check\n\n## 시그니처\n```c\ntypedef enum KiottySpecDecisionKind {\n    KiottySpecDecisionKind_Requirement = 1,  /* 결정 기록: 요구사항 */\n    KiottySpecDecisionKind_Rule,             /* 결정 기록: 개발 규칙 */\n    KiottySpecDecisionKind_Interface,        /* 결정 기록: 외부 인터페이스 */\n    KiottySpecDecisionKind_Design,           /* 결정 기록: 설계 */\n    KiottySpecDecisionKind_UnitTest,         /* 결정 기록: 유닛 테스트 */\n    KiottySpecDecisionKind_Plan              /* 결정 기록: 개발 계획 */\n} KiottySpecDecisionKind;\n```\n\n## 사전조건\n- rewrite 의 markdown 은 줄마다 "- ID · 관심사 : 결정 (이유) [기각: …]"\n\n## 사후조건\n- rewrite: 종류의 결정 기록을 통째로 바꿔 현재 라운드에 쓴다. 이전 체크포인트 시점은 그대로\n- check: 사라진 항목을 가리키는 줄과 한도 초과 줄 보고\n\n## 에러 코드\n- 한 줄이 decision_max_line(기본 200 자) 초과, 항목 하나의 관심사가 decision_max_concerns(기본 8) 초과: InvalidArg (R-7)\n- 없는 CP: NotFound\n- NULL 핸들·NULL 필수 인자는 InvalidArg, 상세는 KiottySpec_lastError\n\n## 소유권\n- get·getAt·check 의 Markdown 은 호출자가 KiottySpec_free\n
body	O	cfc7c974	## 시그니처\n```c\nKiottySpecStatus KiottySpec_File_register(KiottySpec *db, KiottySpecActor actor, KiottySpecFileRole role, const char *path, char **outId);  /* 파일을 등록하고 해시를 기록한다 */\n```\n\n## 사전조건\n- path 는 프로젝트 안 파일 (절대 경로면 루트 기준 상대 경로로 정규화)\n\n## 사후조건\n- FILE-### 발급과 내용 해시 기록. 이미 등록된 경로면 다시 해시하고 기존 ID. 없는 파일은 해시 "missing"\n- *outId 에 ID\n\n## 에러 코드\n- 빈 경로: InvalidArg\n- 같은 경로가 다른 역할로 등록됨: Conflict\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n- 잘못된 actor 값: InvalidArg\n\n## 소유권\n- *outId 는 호출자가 KiottySpec_free\n- 입력 문자열은 호출 동안만 읽는다\n
body	O	d20e9a3e	## 책임\n그룹·동사 뒤의 토큰을 위치 인자, --옵션 값, --플래그로 나눈다. 본문은 --body 텍스트, --body-file 경로, --body - (표준 입력) 중 하나. 모르는 옵션은 사용법 오류.\n\n## 모듈 인터페이스\n```cpp\nnamespace kiotty::cli {\n// 명령줄: "ks <그룹> <동사> [위치 인자...] [--옵션 값...] [--플래그...]"\nclass Arguments {\npublic:\n    explicit Arguments(std::vector<std::string> tokens);\n    const std::vector<std::string> &positional() const { return positional_; }\n    std::string at(size_t index, const char *what) const;            // 없으면 사용법 오류\n    std::optional<std::string> optionalAt(size_t index) const;\n    std::optional<std::string> option(const std::string &name) const;\n    std::string required(const std::string &name) const;\n    int intOption(const std::string &name, int fallback) const;\n    bool flag(const std::string &name) const;\n    // --<name> 값, --<name>-file 경로, --<name> - (표준 입력) 중 하나로 본문을 받는다.\n    std::optional<std::string> text(const std::string &name) const;\n    void requireNoUnknown(const std::set<std::string> &known) const;\n};\nclass UsageError : public std::runtime_error {\npublic:\n    using std::runtime_error::runtime_error;\n};\nint toInt(const std::string &text, const char *what);\n} // namespace kiotty::cli\n```\n\n## 멤버 변수\n- `std::vector<std::string> positional_;`\n- `std::map<std::string, std::string> options_;`\n- `std::set<std::string> flags_;`\n\n## 의존 모듈\n- 없음\n
body	O	d4165e3e	## 개요\n함수 5 개를 묶은 개념 단위. 함수별 계약은 하위 항목에 있고, 여기에는 묶음 공통의 타입과 규약을 둔다.\n\n## 하위 함수\n- UI-074 KiottySpec_Milestone_setEntryState\n- UI-075 KiottySpec_Milestone_entriesBegin\n- UI-076 KiottySpec_Milestone_uncoveredBegin\n- UI-077 KiottySpec_Milestone_next\n- UI-078 KiottySpec_Milestone_progress\n\n## 시그니처\n```c\ntypedef enum KiottySpecImplState {\n    KiottySpecImplState_NotImplemented = 1,  /* 미구현 */\n    KiottySpecImplState_NeedsChange,         /* 변경 필요 (구현 완료 뒤 설계가 바뀜, R-6) */\n    KiottySpecImplState_Implemented          /* 구현 완료 */\n} KiottySpecImplState;\n\ntypedef struct KiottySpecMilestoneEntry {\n    const char *milestoneId;                 /* 마일스톤 */\n    const char *itemId;                      /* 포함된 설계 항목 또는 유닛 테스트 */\n    KiottySpecImplState state;               /* 미구현 / 변경 필요 / 구현 완료 (계산 값) */\n    const char *implementedCp;               /* 구현 완료로 기록된 체크포인트 (없으면 NULL) */\n} KiottySpecMilestoneEntry;\n```\n\n## 사전조건\n- milestoneId 는 마일스톤, itemId 는 그 마일스톤이 포함한다 링크로 가리키는 설계·유닛 테스트\n\n## 사후조건\n- setEntryState(Implemented): 현재 체크포인트를 implementedCp 로 기록\n- entries 의 state 는 계산 값: 구현 완료 뒤 설계가 바뀌면(같은 라운드 포함) NeedsChange (R-6)\n- next: 미구현·변경 필요가 남은 첫 마일스톤, 없으면 NotFound\n- uncovered: 어느 마일스톤에도 없는 설계·유닛 테스트 (R-5)\n\n## 에러 코드\n- 마일스톤이 아니거나 포함하지 않은 항목: InvalidArg\n- 없는 ID: NotFound\n- NULL 핸들·NULL 필수 인자는 InvalidArg, 상세는 KiottySpec_lastError\n\n## 소유권\n- next 의 *outMilestoneId 는 호출자가 KiottySpec_free\n- 커서는 Cursor_end\n
body	O	d573c01b	## 시그니처\n```c\nKiottySpecStatus KiottySpec_Milestone_uncoveredBegin(KiottySpec *db, KiottySpecCursor **outCursor);  /* 어떤 마일스톤에도 포함되지 않은 설계 항목·유닛 테스트 (getItem, R-5) */\n```\n\n## 사전조건\n- 없음\n\n## 사후조건\n- 어느 마일스톤에도 없는 설계 항목·유닛 테스트 커서 (getItem, R-5)\n\n## 에러 코드\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n\n## 소유권\n- *outCursor 커서는 호출자가 KiottySpec_Cursor_end\n
body	O	d6af8843	## 책임\n라운드마다 체크포인트를 만들고 PENDING 쓰기를 그 번호로 묶는다. 조회, 확정 표시, CP 이름 해석, 기준 이전 기록 정리(prune).\n\n## 모듈 인터페이스\n```cpp\nnamespace kiotty::base {\n// 체크포인트: 라운드마다 하나. 미기록(PENDING) 쓰기를 새 체크포인트 번호로 묶는다.\nclass CheckpointStore {\npublic:\n    explicit CheckpointStore(core::Database &db) : db_(db) {}\n    int64_t create(int32_t step, std::string_view note, KiottySpecCheckpointPurpose purpose);\n    std::optional<core::CheckpointRecord> find(int64_t seq);\n    core::CheckpointRecord get(int64_t seq);\n    std::optional<core::CheckpointRecord> latest();\n    std::optional<core::CheckpointRecord> lastConfirmed(int32_t stepOr0);\n    std::vector<core::CheckpointRecord> list(int32_t stepOr0);\n    void markConfirmed(int64_t seq);\n    // "CP-0042" 를 체크포인트 번호로. PENDING 은 kCurrent. 존재하지 않으면 NotFound.\n    int64_t resolve(std::string_view cpId);\n    size_t pendingWriteCount();\n    size_t prune(int64_t baseSeq);\n};\n} // namespace kiotty::base\n```\n\n## 멤버 변수\n- `core::Database &db_;`\n\n## 의존 모듈\n- DSN-012 core::Database\n- DSN-008 core::Error\n- DSN-010 core::names\n- DSN-011 core::records\n- DSN-015 base::schema\n- DSN-009 core::text\n
