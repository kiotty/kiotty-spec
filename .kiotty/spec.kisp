body	O	f20e6c8c	## 책임\nSQLite 연결(WAL, UTF-8)과 준비된 문장의 RAII 래퍼, 중첩 가능한 Savepoint. SQLite 오류는 Db 상태의 Error 로 바꾼다.\n\n## 모듈 인터페이스\n```cpp\nstruct sqlite3;\nstruct sqlite3_stmt;\nnamespace kiotty::core {\nenum class ColumnType { Integer, Float, Text, Blob, Null };\n// sqlite3_stmt 의 RAII 래퍼. 바인딩 인덱스는 1 부터.\nclass Statement {\npublic:\n    Statement(sqlite3 *db, std::string_view sql);\n    ~Statement();\n    Statement(const Statement &) = delete;\n    Statement &operator=(const Statement &) = delete;\n    Statement(Statement &&other) noexcept;\n    Statement &operator=(Statement &&) = delete;\n    template <class... Args>\n    Statement &bindAll(const Args &...args) {\n        int index = 1;\n        (bindOne(index++, args), ...);\n        return *this;\n    }\n    Statement &bindOne(int index, int64_t value);\n    Statement &bindOne(int index, int32_t value) { return bindOne(index, static_cast<int64_t>(value)); }\n    Statement &bindOne(int index, bool value) { return bindOne(index, static_cast<int64_t>(value ? 1 : 0)); }\n    Statement &bindOne(int index, double value);\n    Statement &bindOne(int index, std::string_view value);\n    Statement &bindOne(int index, const std::string &value) { return bindOne(index, std::string_view(value)); }\n    Statement &bindOne(int index, const char *value);\n    Statement &bindOne(int index, std::nullptr_t);\n    Statement &bindOne(int index, const std::optional<std::string> &value);\n    Statement &bindOne(int index, const std::optional<int64_t> &value);\n    bool step();   // 행이 있으면 true\n    void run();    // 끝까지 실행\n    void reset();\n    int columnCount() const;\n    std::string columnName(int column) const;\n    ColumnType columnType(int column) const;\n    bool isNull(int column) const;\n    int64_t integer(int column) const;\n    double real(int column) const;\n    std::string text(int column) const;\n    std::optional<std::string> optText(int column) const;\n    std::optional<int64_t> optInteger(int column) const;\n    bool readOnly() const;\n};\nclass Database {\npublic:\n    explicit Database(const std::string &utf8Path);\n    ~Database();\n    Database(const Database &) = delete;\n    Database &operator=(const Database &) = delete;\n    void exec(std::string_view sql);\n    Statement prepare(std::string_view sql);\n    int64_t lastInsertRowId() const;\n    int64_t changes() const;\n};\n// 중첩 가능한 쓰기 단위. commit() 을 부르지 않고 소멸하면 롤백한다.\nclass Savepoint {\npublic:\n    explicit Savepoint(Database &db);\n    ~Savepoint();\n    Savepoint(const Savepoint &) = delete;\n    Savepoint &operator=(const Savepoint &) = delete;\n    void commit();\n};\n} // namespace kiotty::core\n```\n\n## 멤버 변수\n- `sqlite3 *db_;`\n- `sqlite3_stmt *stmt_;`\n- `sqlite3 *db_ = nullptr;`\n- `Database &db_;`\n- `bool done_ = false;`\n\n## 의존 모듈\n- DSN-008 core::Error\n
body	O	f379d81c	## 책임\n구현 내부의 모든 실패를 상태 코드가 붙은 예외 하나로 표현한다. fail/require 로 던지고, C 경계에서만 상태 코드로 바뀐다 (RULE-006).\n\n## 모듈 인터페이스\n```cpp\nnamespace kiotty::core {\n// 구현 내부의 모든 실패는 이 예외로 표현하고, C 경계에서 KiottySpecStatus 로 바꾼다.\nclass Error : public std::runtime_error {\npublic:\n    Error(KiottySpecStatus status, const std::string &message)\n        : std::runtime_error(message), status_(status) {}\n    KiottySpecStatus status() const noexcept { return status_; }\n};\n[[noreturn]] inline void fail(KiottySpecStatus status, const std::string &message) {\n    throw Error(status, message);\n}\ninline void require(bool condition, KiottySpecStatus status, const std::string &message) {\n    if (!condition) {\n        fail(status, message);\n    }\n}\n} // namespace kiotty::core\n```\n\n## 멤버 변수\n- `KiottySpecStatus status_;`\n\n## 의존 모듈\n- 없음\n
body	O	f3dc42c3	## 시그니처\n```c\nKiottySpecStatus KiottySpec_Check_systemTestOneToOne(KiottySpec *db, KiottySpecCursor **outMissing, KiottySpecCursor **outDuplicated);  /* 시스템 테스트가 없거나 둘 이상인 기능 요구사항 (getItem, R-3) */\n```\n\n## 사전조건\n- 없음\n\n## 사후조건\n- *outMissing 에 시스템 테스트가 없는, *outDuplicated 에 둘 이상인 기능 요구사항 (getItem, R-3)\n\n## 에러 코드\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n\n## 소유권\n- *outMissing 커서는 호출자가 KiottySpec_Cursor_end\n- *outDuplicated 커서는 호출자가 KiottySpec_Cursor_end\n
body	O	f55c48b9	## 시그니처\n```c\nKiottySpecStatus KiottySpec_Item_update(KiottySpec *db, KiottySpecActor actor, const char *itemId, const char *title, const char *body);  /* 제목·본문을 바꾼다. 새 버전은 현재 체크포인트에 속한다 */\n```\n\n## 사전조건\n- 항목이 현재 뷰에 있음\n- title·body 중 NULL 은 바꾸지 않음\n\n## 사후조건\n- 새 버전을 현재 라운드에 쓴다. 이전 체크포인트 시점은 그대로 (R-1)\n\n## 에러 코드\n- 빈 title: InvalidArg\n- 없는 항목: NotFound\n- NULL 핸들·NULL 필수 인자: InvalidArg (상세는 KiottySpec_lastError)\n- 잘못된 actor 값: InvalidArg\n\n## 소유권\n- 돌려받아 해제할 메모리 없음\n- 입력 문자열은 호출 동안만 읽는다\n
