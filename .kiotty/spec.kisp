body	O	99f8ef23	## 책임\n글자 diff 의 중간 레코드(시점 · 나눈 글 · 조각)와 짧은 같음 조각을 합치는 도우미.\n\n타입: Points, SplitText, DiffTexts, Hunk, HunkCursor, HunkList\n\n## 모듈 인터페이스\n```cpp\n// class HunkList\nvoid add(Hunk hunk);\nvoid mergeEqualities();\nvoid extendToWords(DiffTexts texts);\nSpan<const Hunk> view() const;\n// 함수\nconstexpr size_t MAX_POINTS = MAX_DIFF_TEXT_BYTES;\nconstexpr size_t MAX_HUNKS = MAX_POINTS * 2 + 1;\nstatic_assert(sizeof(Points) == 520, "unexpected padding");\nstatic_assert(sizeof(SplitText) == 536, "unexpected padding");\nstatic_assert(sizeof(DiffTexts) == 16, "unexpected padding");\nstatic_assert(sizeof(Hunk) == 10, "unexpected padding");\nstatic_assert(sizeof(HunkCursor) == 16, "unexpected padding");\nsize_t appendHunk(Span<Hunk> hunks, size_t count, Hunk hunk);\nsize_t mergeShortEqualities(Span<Hunk> hunks, size_t count);\nsize_t mergeFirstShortEquality(Span<Hunk> hunks, size_t count);\nbool isShortEqualityAt(Span<const Hunk> hunks, size_t index);\nsize_t measureLargerSide(Hunk hunk);\nsize_t extendEditsToWords(Span<Hunk> hunks, size_t count, DiffTexts texts);\nHunkCursor extendEditToWords(Span<Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nHunkCursor extendEditEnd(Span<Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nbool canMoveEqualForward(Span<const Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nbool isOpenAtEnd(Hunk edit, DiffTexts texts);\nHunkCursor moveEqualForward(Span<Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nHunkCursor removeEmptyEqualAfter(Span<Hunk> hunks, HunkCursor cursor);\nHunkCursor extendEditStart(Span<Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nbool canMoveEqualBackward(Span<const Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nbool isOpenAtStart(Hunk edit, DiffTexts texts);\nHunkCursor moveEqualBackward(Span<Hunk> hunks, HunkCursor cursor, DiffTexts texts);\nHunkCursor mergeWithPreviousEdit(Span<Hunk> hunks, HunkCursor cursor);\nsize_t eraseHunk(Span<Hunk> hunks, size_t count, size_t index);\nbool isSpace(ch